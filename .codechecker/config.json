{
  "analyze": [
    "--disable", "default",
    "--analyzers=clang-tidy",
    "--file=*/dune-common/*.cc",
    "--skip", ".codechecker/skipfile",
    "--disable", "checker:clang-diagnostic-deprecated-copy",
    "--disable", "checker:clang-diagnostic-unused"
  ],
  "parse": [
    "--file=*/dune-common/*"
  ]
}
